{
  "modify": [
    // Offset item height after AG2 update
    {
      "match": {
        "targetname": "[PR#]item_shield_trigger&0000"
      },
      "replace": {
        "origin": "16.000000 2.000000 20.000000"
      }
    },
    {
      "match": {
        "targetname": "[PR#]particle_snow_trigger&0000"
      },
      "replace": {
        "origin": "16.000000 2.000000 0.000000"
      }
    },
    {
      "match": {
        "targetname": "[PR#]particle_snow&0000"
      },
      "replace": {
        "origin": "12.000000 35.000000 -42.000000"
      }
    }
  ]
}