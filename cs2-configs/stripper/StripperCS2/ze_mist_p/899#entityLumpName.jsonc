{
  "modify": [
    // [EXG] Increase dragon health due to buffed weapon damage
    // 900 hp/person -> 1800 hp/person (100% increase)
    {
      "match": {
        "classname": "trigger_multiple",
        "targetname": "[PR#]tr_dragonaddhp"
      },
      "delete": {
        "io": [
          {
            "inputname": "AddHealth"
          }
        ]
      },
      "insert": {
        "io": [
          {
            "outputname": "OnStartTouch",
            "targetname": "[PR#]pbox_dragon",
            "inputname": "AddHealth",
            "overrideparam": "1800",
            "delay": 0.1,
            "timestofire": -1
          }
        ]
      }
    },
    // Fix error models being rendered
    {
      "match": {
        "classname": "momentary_rot_button"
      },
      "replace": {
        "rendermode": "2"
      }
    }
  ]
}